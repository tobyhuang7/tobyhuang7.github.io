---
import Base from '../layouts/Base.astro';
import SectionView from '../components/SectionView.astro';
import { sections } from '../data/portfolio';
import type { PortfolioSection } from '../data/portfolio';

export function getStaticPaths() {
	return sections.map((section) => ({
		params: { slug: section.slug },
		props: { section },
	}));
}

interface Props {
	section: PortfolioSection;
}

const { section } = Astro.props;
const paletteBySlug = {
	'music-and-film': 'music',
	'science-and-observatory': 'science',
	writing: 'writing',
	photography: 'photography',
} as const;
---

<Base
	title={`${section.label} · Toby Huang`}
	theme="dark"
	palette={paletteBySlug[section.slug as keyof typeof paletteBySlug]}
>
	<SectionView section={section} />
</Base>
