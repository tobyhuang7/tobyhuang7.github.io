---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import type { PortfolioSection } from '../data/portfolio';
import Header from './Header.astro';

function imageSize(buf: Buffer) {
	if (buf.length > 24 && buf[0] === 0x89 && buf.toString('ascii', 1, 4) === 'PNG') {
		return { w: buf.readUInt32BE(16), h: buf.readUInt32BE(20) };
	}
	if (buf.length > 30 && buf.toString('ascii', 0, 4) === 'RIFF' && buf.toString('ascii', 8, 12) === 'WEBP') {
		if (buf.toString('ascii', 12, 16) === 'VP8X') {
			return { w: 1 + buf.readUIntLE(24, 3), h: 1 + buf.readUIntLE(27, 3) };
		}
	}
	if (buf[0] === 0xff && buf[1] === 0xd8) {
		let i = 2;
		let orientation = 1;
		let size: { w: number; h: number } | undefined;
		while (i + 9 < buf.length) {
			if (buf[i] !== 0xff) break;
			const marker = buf[i + 1];
			if (marker === 0xd8 || marker === 0xd9) {
				i += 2;
				continue;
			}
			const len = buf.readUInt16BE(i + 2);
			if (marker === 0xe1) orientation = jpegOrientation(buf, i + 4, len) ?? orientation;
			if (marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc) {
				size = { h: buf.readUInt16BE(i + 5), w: buf.readUInt16BE(i + 7) };
			}
			i += 2 + len;
		}
		if (size && orientation >= 5 && orientation <= 8) return { w: size.h, h: size.w };
		return size;
	}
	const viewBox = buf.subarray(0, 800).toString('utf8').match(/viewBox="\s*[\d.]+\s+[\d.]+\s+([\d.]+)\s+([\d.]+)\s*"/);
	if (viewBox) return { w: Number(viewBox[1]), h: Number(viewBox[2]) };
	return undefined;
}

function jpegOrientation(buf: Buffer, start: number, len: number) {
	const end = start + len - 2;
	if (end > buf.length || buf.toString('ascii', start, start + 4) !== 'Exif') return undefined;
	const tiff = start + 6;
	if (tiff + 8 > end) return undefined;
	const little = buf.toString('ascii', tiff, tiff + 2) === 'II';
	const u16 = (offset: number) => (little ? buf.readUInt16LE(offset) : buf.readUInt16BE(offset));
	const u32 = (offset: number) => (little ? buf.readUInt32LE(offset) : buf.readUInt32BE(offset));
	if (u16(tiff + 2) !== 42) return undefined;
	let ifd = tiff + u32(tiff + 4);
	if (ifd + 2 > end) return undefined;
	const count = u16(ifd);
	ifd += 2;
	for (let n = 0; n < count; n++) {
		const entry = ifd + n * 12;
		if (entry + 12 > buf.length) break;
		if (u16(entry) === 0x0112) return u16(entry + 8);
	}
	return undefined;
}

function isPortrait(src: string) {
	try {
		const file = join(process.cwd(), 'public', decodeURIComponent(src).replace(/^\//, ''));
		const size = imageSize(readFileSync(file));
		return !!size && size.h > size.w;
	} catch {
		return false;
	}
}

interface Props {
	section: PortfolioSection;
}

const { section } = Astro.props;
const extras = section.extras ?? [];
const dated = section.projects
	.filter((project) => project.startsAt)
	.slice()
	.sort((a, b) => Date.parse(b.startsAt!) - Date.parse(a.startsAt!));
const projects = [...dated, ...section.projects.filter((project) => !project.startsAt)];
const overlays = [
	...projects.map((project) => ({ ...project, close: '#projects' })),
	...extras.flatMap((extra) =>
		extra.projects.map((project) => ({ ...project, close: `#${extra.id}` })),
	),
].map((project) => ({
	...project,
	captionParts: linkedCaption(project.caption, project.href),
}));

function linkedCaption(caption: string, href?: string) {
	const phrase = 'here.';
	if (!href) return { before: caption, phrase: '', after: '' };
	const at = caption.lastIndexOf(phrase);
	if (at < 0) return { before: caption, phrase: '', after: '' };
	return {
		before: caption.slice(0, at),
		phrase,
		after: caption.slice(at + phrase.length),
	};
}
---

<div class="section-page">
	<Header theme="dark" current={section.slug} />
	<main id="main">
		<div class="copy">
			<h1 data-rise>{section.title}</h1>
			{section.paragraphs.map((paragraph) => <p data-rise>{paragraph}</p>)}
			{
				section.mention && (
					<p data-rise>
						{section.mention.before}{' '}
						<a href={section.mention.href}>{section.mention.label}</a>.
					</p>
				)
			}
			{(section.projects.length > 0 || extras.length > 0) && section.prompt && (
				<p class="prompt" data-rise>{section.prompt}</p>
			)}
		</div>
		{
			dated.length > 0 && (
				<section class="next-show" id="next-show" hidden aria-labelledby="next-show-title">
					<h2 id="next-show-title" data-rise>Next Show:</h2>
					<div class="stage">
						<div class="thumbs">
							{
								dated.map((project) => (
									<a
										data-pop
										data-starts={project.startsAt}
										class:list={{ portrait: isPortrait(project.image), poster: project.fit === 'contain' }}
										href={`#${project.id}`}
										aria-label={project.title}
									>
										<img src={project.image} alt="" width="800" height="520" />
										<span class="thumb-caption">
											<strong>{project.title}</strong>
											<span>{project.caption}</span>
										</span>
									</a>
								))
							}
						</div>
					</div>
				</section>
			)
		}
		{projects.length > 0 && (
			<section class="grid-frame" id="projects" aria-labelledby={section.projectsTitle ? 'projects-title' : undefined}>
			{section.projectsTitle && <h2 id="projects-title" data-rise>{section.projectsTitle}</h2>}
			{
				section.projectsTitle && (
					<div class="when">
						<button type="button" id="when-button" aria-expanded="false" aria-controls="when-menu">
							<span id="when-label">Any time</span>
							<svg viewBox="0 0 12 12" aria-hidden="true">
								<path d="M2.2 4.4 6 8.1l3.8-3.7" />
							</svg>
						</button>
						<div id="when-menu" role="menu" hidden>
							<button type="button" role="menuitemradio" aria-checked="true" data-range="any">Any time</button>
							<button type="button" role="menuitemradio" aria-checked="false" data-range="upcoming">Upcoming</button>
							<button type="button" role="menuitemradio" aria-checked="false" data-range="day">Past 24 hours</button>
							<button type="button" role="menuitemradio" aria-checked="false" data-range="week">Past week</button>
							<button type="button" role="menuitemradio" aria-checked="false" data-range="month">Past month</button>
							<button type="button" role="menuitemradio" aria-checked="false" data-range="year">Past year</button>
						</div>
					</div>
				)
			}
			{section.projectsTitle && <p class="when-empty" id="when-empty" hidden>No shows in this range.</p>}
			<div class="thumbs">
			{
				projects.map((project) => (
					<a
						data-pop
						data-starts={project.startsAt}
						class:list={{ portrait: isPortrait(project.image), poster: project.fit === 'contain' }}
						href={`#${project.id}`}
						aria-label={project.title}
					>
						<img src={project.image} alt="" width="800" height="520" />
						<span class="thumb-caption">
							<strong>{project.title}</strong>
							<span>{project.caption}</span>
						</span>
					</a>
				))
			}
			</div>
		</section>
		)}
		<script is:inline>
			(function () {
				var featured = document.getElementById('next-show');
				var grid = document.getElementById('projects');
				if (featured) {
					var cards = Array.prototype.slice.call(featured.querySelectorAll('[data-starts]'));
					var now = Date.now();
					var next = null;
					var nextTime = Infinity;
					for (var i = 0; i < cards.length; i++) {
						var time = Date.parse(cards[i].getAttribute('data-starts'));
						if (time >= now && time < nextTime) {
							next = cards[i];
							nextTime = time;
						}
					}
					for (var j = 0; j < cards.length; j++) {
						if (cards[j] !== next) cards[j].remove();
					}
					if (next) {
						featured.hidden = false;
						var dupe = grid && grid.querySelector('a[href="' + next.getAttribute('href') + '"]');
						if (dupe) dupe.remove();
					}
				}

				var button = document.getElementById('when-button');
				var menu = document.getElementById('when-menu');
				var label = document.getElementById('when-label');
				var empty = document.getElementById('when-empty');
				if (!button || !menu || !grid) return;

				function showRange(range) {
					var now = Date.now();
					var day = 24 * 60 * 60 * 1000;
					var limit = range === 'day' ? day : range === 'week' ? 7 * day : range === 'month' ? 30 * day : 365 * day;
					var shown = 0;
					Array.prototype.forEach.call(grid.querySelectorAll('.thumbs a'), function (card) {
						var raw = card.getAttribute('data-starts');
						var time = raw ? Date.parse(raw) : NaN;
						var keep = range === 'any';
						if (!keep && !isNaN(time)) {
							if (range === 'upcoming') keep = time >= now;
							else keep = time < now && time >= now - limit;
						}
						card.hidden = !keep;
						if (keep) shown += 1;
					});
					if (empty) empty.hidden = shown > 0;
				}

				function closeMenu() {
					button.setAttribute('aria-expanded', 'false');
					menu.hidden = true;
				}

				button.addEventListener('click', function (event) {
					event.stopPropagation();
					var open = button.getAttribute('aria-expanded') === 'true';
					button.setAttribute('aria-expanded', open ? 'false' : 'true');
					menu.hidden = open;
				});
				menu.addEventListener('click', function (event) {
					var choice = event.target.closest('button[data-range]');
					if (!choice) return;
					Array.prototype.forEach.call(menu.querySelectorAll('button'), function (item) {
						item.setAttribute('aria-checked', item === choice ? 'true' : 'false');
					});
					label.textContent = choice.textContent;
					showRange(choice.getAttribute('data-range'));
					closeMenu();
				});
				document.addEventListener('click', closeMenu);
				document.addEventListener('keydown', function (event) {
					if (event.key === 'Escape') closeMenu();
				});
			})();
		</script>
		{
			extras.map((extra) => (
				<section class="extra" id={extra.id} aria-labelledby={`${extra.id}-title`}>
					<h2 id={`${extra.id}-title`} data-rise>{extra.title}</h2>
					<div class="thumbs">
						{extra.projects.map((project) => (
							<a
								data-pop
								class:list={{ portrait: isPortrait(project.image), poster: project.fit === 'contain' }}
								href={`#${project.id}`}
								aria-label={project.title}
							>
								<img src={project.image} alt="" width="800" height="520" />
								<span class="thumb-caption">
									<strong>{project.title}</strong>
									<span>{project.caption}</span>
								</span>
							</a>
						))}
					</div>
				</section>
			))
		}
	</main>
	{
		overlays.map((project) => (
			<div class="overlay" id={project.id}>
				<a class="overlay-close" href={project.close}>
					Close
				</a>
				<figure>
					<img src={project.image} alt="" />
				</figure>
				<p class="overlay-caption">
					<strong>{project.title}</strong>
					<span>
						{project.captionParts.before}
						{
							project.captionParts.phrase && project.href && (
								<a href={project.href} target="_blank" rel="noreferrer">
									{project.captionParts.phrase}
								</a>
							)
						}
						{project.captionParts.after}
					</span>
				</p>
			</div>
		))
	}
</div>

<style>
	.section-page {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	main {
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.copy {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		text-align: center;
		padding: 1.5rem 1.25rem 1.25rem;
	}

	h1,
	.prompt {
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-style: italic;
		font-weight: 400;
		color: var(--accent);
	}

	h1 {
		margin: 0 0 1.1rem;
		font-size: clamp(2.3rem, 5vw, 3.5rem);
	}

	.copy p {
		max-width: 44rem;
		margin: 0.45rem auto;
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-size: 1.02rem;
		line-height: 1.7;
		color: var(--text);
	}

	.copy a {
		color: var(--accent);
		text-underline-offset: 0.28em;
	}

	.prompt {
		margin-top: 1.35rem;
		font-size: 1.2rem;
	}

	.grid-frame,
	.extra,
	.next-show .stage {
		container-type: inline-size;
	}

	.extra {
		padding: 0 0.65rem 1.5rem;
	}

	.next-show {
		padding: 0 0 1.5rem;
	}

	.extra h2,
	.grid-frame h2,
	.next-show h2 {
		margin: 0.4rem 0 0.85rem;
		text-align: center;
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-style: italic;
		font-weight: 400;
		font-size: clamp(1.8rem, 4vw, 2.4rem);
		color: var(--accent);
	}

	.next-show h2 {
		padding: 0 0.65rem;
		font-size: clamp(2.15rem, 5vw, 3rem);
	}

	.grid-frame {
		padding: 0 0.65rem 0.65rem;
	}

	.next-show .stage {
		width: 100%;
	}

	.grid-frame h2 {
		margin-bottom: 0.45rem;
	}

	.thumbs {
		--gap: 0.65rem;
		--cols: 3;
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		grid-auto-rows: calc((100cqi - (var(--cols) - 1) * var(--gap)) / var(--cols) / 1.414213562);
		grid-auto-flow: dense;
		gap: var(--gap);
	}

	.next-show .thumbs {
		--cols: 1;
		grid-auto-rows: calc(100cqi / 2);
	}

	.next-show .thumbs img {
		object-fit: contain;
	}

	.thumbs a[hidden] {
		display: none;
	}

	.thumbs a {
		position: relative;
		display: block;
		min-width: 0;
		min-height: 0;
		overflow: hidden;
		background: #101426;
	}

	.thumb-caption {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		margin: 0;
		padding: 1rem 0.9rem;
		text-align: center;
		color: #f7f4ff;
		background: rgb(0 0 0 / 0.46);
		opacity: 0;
		pointer-events: none;
		transition: opacity 180ms ease;
	}

	.thumbs a:hover .thumb-caption,
	.thumbs a:focus-visible .thumb-caption {
		opacity: 1;
	}

	.thumb-caption strong,
	.thumb-caption span {
		-webkit-text-stroke: 1px #000;
		paint-order: stroke fill;
		text-shadow:
			0 0 3px #000,
			0 0 8px #000;
	}

	.thumb-caption strong {
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-style: italic;
		font-weight: 400;
		font-size: clamp(1.2rem, 2.2vw, 1.65rem);
		line-height: 1.25;
		color: var(--on-photo, var(--accent));
	}

	.thumb-caption span {
		font-size: clamp(0.98rem, 1.5vw, 1.15rem);
		line-height: 1.4;
	}

	.thumbs a.portrait {
		grid-row: span 2;
	}

	.thumbs img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
	}

	.thumbs a.poster {
		background: #000;
	}

	.thumbs a.poster img {
		object-fit: contain;
	}

	.when {
		position: relative;
		display: flex;
		justify-content: center;
		margin: 0 0 1rem;
	}

	.when > button {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.75rem;
		border: 0;
		border-radius: 4px;
		background: transparent;
		color: var(--text);
		font: 400 0.98rem/1.2 "Source Sans 3", "Segoe UI", sans-serif;
		cursor: pointer;
	}

	.when > button svg {
		width: 0.75rem;
		height: 0.75rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.when > button:hover,
	.when > button[aria-expanded='true'] {
		background: color-mix(in srgb, var(--text) 8%, transparent);
	}

	.when [role='menu'] {
		position: absolute;
		top: calc(100% + 0.2rem);
		left: 50%;
		z-index: 5;
		display: flex;
		flex-direction: column;
		min-width: 12.5rem;
		margin: 0;
		padding: 0.35rem 0;
		transform: translateX(-50%);
		background: var(--bg);
		border-radius: 8px;
		box-shadow: 0 4px 18px rgba(20, 16, 24, 0.18);
	}

	.when [role='menu'][hidden] {
		display: none;
	}

	.when [role='menuitemradio'] {
		padding: 0.5rem 1rem;
		border: 0;
		background: transparent;
		color: var(--text);
		font: 400 0.98rem/1.3 "Source Sans 3", "Segoe UI", sans-serif;
		text-align: left;
		cursor: pointer;
	}

	.when [role='menuitemradio']:hover,
	.when [role='menuitemradio']:focus-visible {
		background: color-mix(in srgb, var(--text) 8%, transparent);
	}

	.when [role='menuitemradio'][aria-checked='true'] {
		color: var(--accent);
		font-weight: 600;
	}

	.when-empty {
		margin: 0 0.65rem 1rem;
		text-align: center;
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-style: italic;
		color: var(--text);
	}

	.thumbs a:hover img,
	.thumbs a:focus-visible img {
		transform: scale(1.03);
	}

	.thumbs img {
		transition: transform 180ms ease;
	}

	.overlay {
		position: fixed;
		inset: 0;
		z-index: 30;
		display: grid;
		place-items: center;
		padding: 0;
		background: rgb(0 0 0 / 0);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			background-color 0.45s ease,
			opacity 0.45s ease,
			visibility 0s linear 0.45s;
	}

	.overlay:target {
		background: #000;
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transition:
			background-color 0.45s ease,
			opacity 0.45s ease,
			visibility 0s;
	}

	.overlay figure {
		position: absolute;
		z-index: 1;
		inset: 0;
		margin: 0;
	}

	.overlay img {
		position: absolute;
		top: 50%;
		left: 50%;
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		transform: translate(-50%, -50%);
	}

	.overlay-caption {
		position: absolute;
		z-index: 2;
		right: 0;
		bottom: 0;
		left: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		margin: 0;
		padding: 2.6rem 1.25rem 1.2rem;
		text-align: center;
		color: #f7f4ff;
		opacity: 1;
		pointer-events: none;
		transition: opacity 0.8s ease;
	}

	.overlay-caption strong,
	.overlay-caption span {
		-webkit-text-stroke: 2px #000;
		paint-order: stroke fill;
		text-shadow:
			0 0 3px #000,
			0 0 8px #000,
			0 0 16px #000;
	}

	.overlay-caption a {
		color: var(--on-photo, var(--accent));
		pointer-events: auto;
		text-underline-offset: 0.18em;
	}

	.overlay.is-idle .overlay-caption {
		opacity: 0;
	}

	.overlay strong {
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-style: italic;
		font-weight: 400;
		font-size: 1.45rem;
		color: var(--on-photo, var(--accent));
	}

	.overlay-close {
		position: absolute;
		z-index: 2;
		top: 1.1rem;
		right: 1.25rem;
		color: var(--on-photo, var(--accent));
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-style: italic;
		text-decoration: none;
		font-size: 1.15rem;
	}

	@media (max-width: 720px) {
		.thumbs {
			--cols: 1;
		}

		.next-show .stage {
			width: 100%;
		}

		.copy p {
			font-size: 0.98rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.thumbs img,
		.thumb-caption,
		.overlay,
		.overlay-caption {
			transition: none;
		}

		.overlay.is-idle .overlay-caption {
			opacity: 1;
		}
	}
</style>

<script>
	const idleDelay = 3000;
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	let idleTimer = 0;

	function openOverlay() {
		return document.querySelector<HTMLElement>('.overlay:target');
	}

	function wake() {
		const overlay = openOverlay();
		window.clearTimeout(idleTimer);
		if (!overlay || reduceMotion) return;
		overlay.classList.remove('is-idle');
		idleTimer = window.setTimeout(() => overlay.classList.add('is-idle'), idleDelay);
	}

	function closeOverlay() {
		const overlay = openOverlay();
		const href = overlay?.querySelector('a.overlay-close')?.getAttribute('href');
		if (href) location.hash = href;
	}

	window.addEventListener('hashchange', wake);
	window.addEventListener('pointermove', wake);
	window.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape' || !openOverlay()) return;
		event.preventDefault();
		closeOverlay();
	});
	document.addEventListener('click', (event) => {
		const overlay = openOverlay();
		if (!overlay || !(event.target instanceof Node) || !overlay.contains(event.target)) return;
		const figure = overlay.querySelector('figure');
		if (event.target === overlay || event.target === figure) closeOverlay();
	});
	wake();
</script>
