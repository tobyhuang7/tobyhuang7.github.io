---
interface Props {
	to: string;
}

const { to } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={new URL(to, Astro.site)} />
		<title>Redirecting</title>
		<script is:inline define:vars={{ to }}>
			location.replace(to + location.hash);
		</script>
		<meta http-equiv="refresh" content={`0;url=${to}`} />
	</head>
	<body>
		<a href={to}>Continue</a>
	</body>
</html>
