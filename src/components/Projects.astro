---
import Header from './Header.astro';
import { nav } from '../data/portfolio';

const facts = [
	{ figure: '2,600+', detail: 'in Woolsey Hall for the Halloween Show', href: '/music-and-film' },
	{ figure: '4+', detail: 'cities for organized benefit concerts' },
	{ figure: '12', detail: 'years playing the violin' },
	{
		figure: '2',
		detail: 'years working to rebuild Dixon Observatory at Berkshire School',
	},
];

const interests = [
	'Violin',
	'Theater',
	'Choir',
	'Film',
	'Philosophy',
	'Physics',
	'Astrophotography',
];
---

<div class="home">
	<Header theme="light" />
	<main id="main">
		<section class="hi" id="hi" aria-labelledby="greeting">
			<div class="panel">
				<figure class="shot side" data-pop>
					<img
						src="/images/IMG_1058.jpg"
						alt="Toby sitting on a bench in a green hoodie, holding a camera."
						width="4412"
						height="6618"
					/>
				</figure>
				<figure class="shot center" data-pop>
					<img
						src="/images/130581791769116_.pic_hd.jpg"
						alt="Toby in a light blue patterned shirt, standing indoors."
						width="5472"
						height="3080"
					/>
					<h1 id="greeting">Hi, I’m Toby.</h1>
				</figure>
				<figure class="shot side violin" data-pop>
					<img
						src="/images/BKS-308-X4.jpg"
						alt="Toby playing violin on a dark stage, beside a music stand."
						width="1366"
						height="2048"
					/>
				</figure>
			</div>
		</section>

		<section class="intro" id="introduction" aria-labelledby="intro-title">
			<div class="intro-inner">
				<h2 id="intro-title" data-rise>Introduction</h2>
				<p data-rise>
					I’m Toby Huang, a Yale student in Physics and Philosophy. I play in the
					Symphony Orchestra, direct its Halloween film, and founded an observatory
					and a series of benefit concerts.
				</p>
				<p data-rise>A few facts below. The tabs after them open the work.</p>
				{/* TODO: Toby to review wording */}
				<p data-rise>
					I study what we can know, and how people should live together, and I
					start things and get them running: the observatory, the benefit
					concerts, and the film.
				</p>
				<ul class="facts">
					{
						facts.map((fact) => (
							<li data-rise>
								<strong>{fact.figure}</strong>
								<span>
									{
										fact.href ? (
											<>
												{fact.detail.replace('Halloween Show', '')}
												<a href={fact.href}>Halloween Show</a>
											</>
										) : (
											fact.detail
										)
									}
								</span>
							</li>
						))
					}
				</ul>
				<ul class="interests" aria-label="Skills and interests" data-rise>
					{interests.map((interest) => <li>{interest}</li>)}
				</ul>
			</div>
		</section>

		<section class="tabs" id="tabs" aria-labelledby="tabs-title">
			<div class="tabs-inner">
				<h2 id="tabs-title" data-rise>Pick a tab</h2>
				<ul>
					{
						nav.map((section) => (
							<li data-rise>
								<a href={`/${section.slug}`}>
									<span>{section.label}</span>
									<small>{section.lede}</small>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</section>
	</main>
</div>

<style>
	.hi {
		min-height: calc(100vh - 4.4rem);
		display: flex;
		flex-direction: column;
	}

	.panel {
		flex: 1;
		display: grid;
		grid-template-columns: 0.92fr 1.08fr 0.92fr;
		gap: clamp(0.75rem, 1.8vw, 1.45rem);
		align-items: center;
		margin: 0 clamp(0.85rem, 2.6vw, 2.4rem) clamp(0.85rem, 2vw, 1.5rem);
		padding: clamp(1.1rem, 2.4vw, 2.1rem);
		background: #95acf8;
		min-height: 32rem;
	}

	.shot {
		position: relative;
		margin: 0;
		overflow: hidden;
		background: #1c2036;
	}

	.shot img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.shot::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: rgba(149, 172, 248, 0.1);
		pointer-events: none;
	}

	.shot.violin img {
		object-position: left top;
		transform: scale(1.3);
		transform-origin: left top;
	}

	.shot.side {
		height: min(72vh, 40rem);
	}

	.shot.center {
		height: min(58vh, 32rem);
	}

	.shot.center img {
		object-position: center 26%;
	}

	h1 {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: grid;
		place-items: center;
		margin: 0;
		padding: 1rem;
		color: #fff;
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-size: clamp(2.4rem, 4.4vw, 4.15rem);
		font-weight: 400;
		letter-spacing: -0.02em;
		text-align: center;
		text-shadow: 0 2px 16px rgba(12, 8, 24, 0.45);
	}

	.intro,
	.tabs {
		padding: 4.25rem 1.25rem 3.5rem;
	}

	.intro-inner,
	.tabs-inner {
		max-width: 52rem;
		margin: 0 auto;
	}

	.intro h2,
	.tabs h2 {
		margin: 0;
		text-align: center;
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-weight: 400;
		font-style: italic;
		color: #6a7ab4;
	}

	.intro h2,
	.tabs h2 {
		font-size: clamp(2rem, 4vw, 2.7rem);
	}

	.intro p {
		max-width: 40rem;
		margin: 1rem auto 0;
		text-align: center;
		font-size: 1.12rem;
		line-height: 1.65;
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem 1rem;
		margin: 1.5rem 0 0;
		padding: 1.15rem 0 0;
		list-style: none;
		text-align: center;
		border-top: 1px solid rgba(106, 122, 180, 0.35);
	}

	.facts strong {
		display: block;
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-style: italic;
		font-weight: 400;
		font-size: clamp(1.8rem, 3vw, 2.35rem);
		line-height: 1.1;
		color: #6a7ab4;
	}

	.facts span {
		display: block;
		margin-top: 0.4rem;
		font-size: 0.95rem;
		line-height: 1.45;
	}

	.facts a {
		color: #6a7ab4;
		text-underline-offset: 0.18em;
	}

	.interests {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.35rem 0;
		margin: 1.35rem 0 0;
		padding: 0;
		list-style: none;
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-style: italic;
		color: #5d6da8;
	}

	.interests li:not(:last-child)::after {
		content: "·";
		margin: 0 0.55rem;
		font-style: normal;
		color: #6a7ab4;
	}

	.tabs ul {
		list-style: none;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.85rem;
		width: min(100%, 36rem);
		margin: 1.6rem auto 0;
		padding: 0;
	}

	.tabs a {
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		gap: 0.65rem;
		aspect-ratio: 1;
		min-height: 11rem;
		padding: 1.15rem 1.1rem 1rem;
		background: #fff;
		color: #5d6da8;
		text-decoration: none;
		box-shadow: 0 10px 28px rgba(70, 86, 150, 0.08);
	}

	.tabs a span {
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-style: italic;
		font-size: 1.28rem;
		line-height: 1.3;
	}

	.tabs a small {
		color: #3a4468;
		font-size: 0.98rem;
		line-height: 1.4;
	}

	.tabs a:hover,
	.tabs a:focus-visible {
		background: #181d3b;
		color: #ee9cf9;
	}

	.tabs a:hover small,
	.tabs a:focus-visible small {
		color: #f7f4ff;
	}

	:global(body[data-theme='dark']) .panel {
		background: #242b4e;
	}

	:global(body[data-theme='dark']) .intro h2,
	:global(body[data-theme='dark']) .tabs h2,
	:global(body[data-theme='dark']) .facts strong,
	:global(body[data-theme='dark']) .facts a,
	:global(body[data-theme='dark']) .interests li:not(:last-child)::after {
		color: #ee9cf9;
	}

	:global(body[data-theme='dark']) .interests {
		color: #f7f4ff;
	}

	:global(body[data-theme='dark']) .facts {
		border-top-color: rgba(238, 156, 249, 0.35);
	}

	:global(body[data-theme='dark']) .tabs a {
		background: #101426;
		color: #ee9cf9;
		box-shadow: none;
	}

	:global(body[data-theme='dark']) .tabs a small {
		color: #f7f4ff;
	}

	:global(body[data-theme='dark']) .tabs a:hover,
	:global(body[data-theme='dark']) .tabs a:focus-visible {
		background: #95acf8;
		color: #181d3b;
	}

	:global(body[data-theme='dark']) .tabs a:hover small,
	:global(body[data-theme='dark']) .tabs a:focus-visible small {
		color: #181d3b;
	}

	.tabs a[href='/music-and-film'] {
		background: #f8efe4;
		color: #8d3a4c;
	}

	.tabs a[href='/music-and-film'] small {
		color: #3a2a2c;
	}

	.tabs a[href='/music-and-film']:hover,
	.tabs a[href='/music-and-film']:focus-visible {
		background: #221318;
		color: #e4b15a;
	}

	.tabs a[href='/music-and-film']:hover small,
	.tabs a[href='/music-and-film']:focus-visible small {
		color: #f6efe6;
	}

	.tabs a[href='/writing'] {
		background: #e7eee6;
		color: #1e3d32;
	}

	.tabs a[href='/writing'] small {
		color: #243028;
	}

	.tabs a[href='/writing']:hover,
	.tabs a[href='/writing']:focus-visible {
		background: #141c18;
		color: #e4d3b0;
	}

	.tabs a[href='/writing']:hover small,
	.tabs a[href='/writing']:focus-visible small {
		color: #f3efe6;
	}

	.tabs a[href='/photography'] {
		background: #e7e5e1;
		color: #1c1b19;
	}

	.tabs a[href='/photography'] small {
		color: #3d3b38;
	}

	.tabs a[href='/photography']:hover,
	.tabs a[href='/photography']:focus-visible {
		background: #121212;
		color: #d4cfc6;
	}

	.tabs a[href='/photography']:hover small,
	.tabs a[href='/photography']:focus-visible small {
		color: #f2f0ec;
	}

	:global(body[data-theme='dark']) .tabs a[href='/music-and-film'] {
		background: #221318;
		color: #e4b15a;
	}

	:global(body[data-theme='dark']) .tabs a[href='/music-and-film'] small {
		color: #f6efe6;
	}

	:global(body[data-theme='dark']) .tabs a[href='/music-and-film']:hover,
	:global(body[data-theme='dark']) .tabs a[href='/music-and-film']:focus-visible {
		background: #e4b15a;
		color: #221318;
	}

	:global(body[data-theme='dark']) .tabs a[href='/music-and-film']:hover small,
	:global(body[data-theme='dark']) .tabs a[href='/music-and-film']:focus-visible small {
		color: #221318;
	}

	:global(body[data-theme='dark']) .tabs a[href='/writing'] {
		background: #141c18;
		color: #e4d3b0;
	}

	:global(body[data-theme='dark']) .tabs a[href='/writing'] small {
		color: #f3efe6;
	}

	:global(body[data-theme='dark']) .tabs a[href='/writing']:hover,
	:global(body[data-theme='dark']) .tabs a[href='/writing']:focus-visible {
		background: #e4d3b0;
		color: #141c18;
	}

	:global(body[data-theme='dark']) .tabs a[href='/writing']:hover small,
	:global(body[data-theme='dark']) .tabs a[href='/writing']:focus-visible small {
		color: #141c18;
	}

	:global(body[data-theme='dark']) .tabs a[href='/photography'] {
		background: #121212;
		color: #d4cfc6;
	}

	:global(body[data-theme='dark']) .tabs a[href='/photography'] small {
		color: #f2f0ec;
	}

	:global(body[data-theme='dark']) .tabs a[href='/photography']:hover,
	:global(body[data-theme='dark']) .tabs a[href='/photography']:focus-visible {
		background: #d4cfc6;
		color: #121212;
	}

	:global(body[data-theme='dark']) .tabs a[href='/photography']:hover small,
	:global(body[data-theme='dark']) .tabs a[href='/photography']:focus-visible small {
		color: #121212;
	}

	@media (max-width: 860px) {
		.panel {
			grid-template-columns: 1fr;
			min-height: 0;
		}

		.shot.center {
			order: -1;
			height: min(92vw, 34rem);
		}

		.shot.side {
			height: min(70vw, 24rem);
		}

		.facts {
			grid-template-columns: 1fr 1fr;
		}

		.tabs a {
			aspect-ratio: auto;
			min-height: 9rem;
		}
	}
</style>
