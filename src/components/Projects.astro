---
import Header from './Header.astro';
import { nav } from '../data/portfolio';

const facts = [
	{ figure: '2,600+', detail: 'in Woolsey Hall for the Halloween film' },
	{ figure: '4+', detail: 'cities for organized benefit concerts' },
	{ figure: '12', detail: 'years playing the violin' },
	{
		figure: '2',
		detail: 'years working to rebuild Dixon Observatory at Berkshire School',
	},
];

const interests = [
	'Violin',
	'Theater',
	'Choir',
	'Film',
	'Philosophy',
	'Physics',
	'Astrophotography',
];
---

<div class="home">
	<Header theme="light" />
	<main id="main">
		<section class="hi" id="hi" aria-labelledby="greeting">
			<div class="panel">
				<figure class="shot side">
					<img
						src="/images/hero-camera.svg"
						alt="A green jacket, pale wall, and a camera."
						width="640"
						height="900"
					/>
				</figure>
				<figure class="shot center">
					<img
						src="/images/hero-stage.svg"
						alt="Warm stage light, a tan coat, and an orange vest."
						width="760"
						height="860"
					/>
					<h1 id="greeting">Hi, I’m Toby.</h1>
				</figure>
				<figure class="shot side">
					<img
						src="/images/hero-violin.svg"
						alt="A violin and music stand on a dark stage."
						width="640"
						height="900"
					/>
				</figure>
			</div>
		</section>

		<section class="intro" id="introduction" aria-labelledby="intro-title">
			<div class="intro-inner">
				<h2 id="intro-title">Introduction</h2>
				<p>
					I’m Toby Huang, a Yale student in Physics and Philosophy. I play in the
					Symphony Orchestra, direct its Halloween film, and founded an observatory
					and a series of benefit concerts.
				</p>
				<p>A few facts below. The tabs after them open the work.</p>
				{/* TODO: Toby to review wording */}
				<p>
					I study what we can know, and how people should live together, and I
					start things and get them running: the observatory, the benefit
					concerts, and the film.
				</p>
				<ul class="facts">
					{
						facts.map((fact) => (
							<li>
								<strong>{fact.figure}</strong>
								<span>{fact.detail}</span>
							</li>
						))
					}
				</ul>
				<ul class="interests" aria-label="Skills and interests">
					{interests.map((interest) => <li>{interest}</li>)}
				</ul>
			</div>
		</section>

		<section class="tabs" id="tabs" aria-labelledby="tabs-title">
			<div class="tabs-inner">
				<h2 id="tabs-title">Pick a tab</h2>
				<ul>
					{
						nav.map((section) => (
							<li>
								<a href={`/${section.slug}`}>
									<span>{section.label}</span>
									<small>{section.lede}</small>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</section>
	</main>
</div>

<style>
	.hi {
		min-height: calc(100vh - 4.4rem);
		display: flex;
		flex-direction: column;
	}

	.panel {
		flex: 1;
		display: grid;
		grid-template-columns: 0.92fr 1.08fr 0.92fr;
		gap: clamp(0.75rem, 1.8vw, 1.45rem);
		align-items: center;
		margin: 0 clamp(0.85rem, 2.6vw, 2.4rem) clamp(0.85rem, 2vw, 1.5rem);
		padding: clamp(1.1rem, 2.4vw, 2.1rem);
		background: #95acf8;
		min-height: 32rem;
	}

	.shot {
		position: relative;
		margin: 0;
		overflow: hidden;
		background: #1c2036;
	}

	.shot img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.shot.side {
		height: min(72vh, 40rem);
	}

	.shot.center {
		height: min(52vh, 28rem);
	}

	.shot.center::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			transparent 0%,
			rgba(22, 16, 36, 0.28) 42%,
			rgba(22, 16, 36, 0.28) 58%,
			transparent 100%
		);
		pointer-events: none;
	}

	h1 {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: grid;
		place-items: center;
		margin: 0;
		padding: 1rem;
		color: #fff;
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-size: clamp(2.4rem, 4.4vw, 4.15rem);
		font-weight: 400;
		letter-spacing: -0.02em;
		text-align: center;
		text-shadow: 0 2px 16px rgba(12, 8, 24, 0.45);
	}

	.intro,
	.tabs {
		padding: 4.25rem 1.25rem 3.5rem;
	}

	.intro-inner,
	.tabs-inner {
		max-width: 52rem;
		margin: 0 auto;
	}

	.intro h2,
	.tabs h2 {
		margin: 0;
		text-align: center;
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-weight: 400;
		font-style: italic;
		color: #6a7ab4;
	}

	.intro h2,
	.tabs h2 {
		font-size: clamp(2rem, 4vw, 2.7rem);
	}

	.intro p {
		max-width: 40rem;
		margin: 1rem auto 0;
		text-align: center;
		font-size: 1.12rem;
		line-height: 1.65;
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem 1rem;
		margin: 1.5rem 0 0;
		padding: 1.15rem 0 0;
		list-style: none;
		text-align: center;
		border-top: 1px solid rgba(106, 122, 180, 0.35);
	}

	.facts strong {
		display: block;
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-style: italic;
		font-weight: 400;
		font-size: clamp(1.8rem, 3vw, 2.35rem);
		line-height: 1.1;
		color: #6a7ab4;
	}

	.facts span {
		display: block;
		margin-top: 0.4rem;
		font-size: 0.95rem;
		line-height: 1.45;
	}

	.interests {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.35rem 0;
		margin: 1.35rem 0 0;
		padding: 0;
		list-style: none;
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-style: italic;
		color: #5d6da8;
	}

	.interests li:not(:last-child)::after {
		content: "·";
		margin: 0 0.55rem;
		font-style: normal;
		color: #6a7ab4;
	}

	.tabs ul {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
		gap: 0.85rem;
		margin: 1.6rem 0 0;
		padding: 0;
	}

	.tabs a {
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		gap: 0.65rem;
		min-height: 9.2rem;
		padding: 1.15rem 1.1rem 1rem;
		background: #fff;
		color: #5d6da8;
		text-decoration: none;
		box-shadow: 0 10px 28px rgba(70, 86, 150, 0.08);
	}

	.tabs a span {
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		font-style: italic;
		font-size: 1.28rem;
		line-height: 1.3;
	}

	.tabs a small {
		color: #3a4468;
		font-size: 0.98rem;
		line-height: 1.4;
	}

	.tabs a:hover,
	.tabs a:focus-visible {
		background: #181d3b;
		color: #ee9cf9;
	}

	.tabs a:hover small,
	.tabs a:focus-visible small {
		color: #f7f4ff;
	}

	@media (max-width: 860px) {
		.panel {
			grid-template-columns: 1fr;
			min-height: 0;
		}

		.shot.center {
			order: -1;
			height: min(62vw, 22rem);
		}

		.shot.side {
			height: min(70vw, 24rem);
		}

		.facts {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
