---
import { nav } from '../data/portfolio';

interface Props {
	theme: 'light' | 'dark';
	current?: string;
}

const { theme, current } = Astro.props;
---

<header class:list={['site-header', theme]}>
	<a class="brand" href="/">Toby’s Portfolio</a>
	<nav aria-label="Portfolio sections">
		{
			nav.map((item) => (
				<a
					href={`/${item.slug}`}
					aria-current={current === item.slug ? 'page' : undefined}
				>
					{item.label}
				</a>
			))
		}
	</nav>
	<a class="corner" href="/" aria-label="Home">
		<span aria-hidden="true">×</span>
	</a>
</header>

<style>
	.site-header {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem 2rem;
		width: 100%;
		min-height: 4.4rem;
		padding: 0.95rem 5rem 0.95rem 2.2rem;
	}

	.brand,
	nav a {
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		text-decoration: none;
	}

	.brand {
		font-style: italic;
		font-size: 1.45rem;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	nav {
		display: flex;
		flex: 1 1 auto;
		flex-wrap: wrap;
		justify-content: flex-end;
		min-width: 0;
		gap: 0.35rem 1.2rem;
	}

	nav a {
		font-size: 0.92rem;
	}

	nav a[aria-current='page'],
	nav a:hover {
		text-decoration: underline;
		text-underline-offset: 0.28em;
	}

	.light .brand,
	.light nav a {
		color: #6a7ab4;
	}

	.dark .brand,
	.dark nav a {
		color: #ee9cf9;
	}

	.corner {
		position: absolute;
		top: 0;
		right: 0;
		z-index: 2;
		width: 4.6rem;
		height: 4.6rem;
		color: #161616;
		text-decoration: none;
		font-size: 1.45rem;
		line-height: 1;
	}

	.corner::before {
		content: "";
		position: absolute;
		inset: 0;
		background: #fff;
		clip-path: polygon(0 0, 100% 0, 100% 100%);
	}

	.corner span {
		position: absolute;
		top: 0.22rem;
		right: 0.5rem;
		z-index: 1;
	}

	@media (max-width: 860px) {
		.site-header {
			align-items: flex-start;
			flex-direction: column;
			padding: 0.9rem 4.2rem 0.85rem 1.1rem;
			gap: 0.55rem;
		}

		nav {
			justify-content: flex-start;
		}
	}
</style>
