---
import { nav } from '../data/portfolio';

interface Props {
	theme: 'light' | 'dark';
	current?: string;
}

const { theme, current } = Astro.props;
---

<header class:list={['site-header', theme]}>
	<a class="brand" href="/">Toby Huang</a>
	<nav aria-label="Portfolio sections">
		{
			nav.map((item) => (
				<a
					href={`/${item.slug}`}
					aria-current={current === item.slug ? 'page' : undefined}
				>
					{item.label}
				</a>
			))
		}
	</nav>
	<button
		class="theme-toggle"
		type="button"
		aria-pressed={theme === 'dark' ? 'true' : 'false'}
		aria-label={theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'}
	>
		<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
			<path
				d="M21 14.5A8.5 8.5 0 1 1 9.5 3a7 7 0 0 0 11.5 11.5z"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linejoin="round"></path>
		</svg>
		<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="12" cy="12" r="3.4" fill="none" stroke="currentColor" stroke-width="1.6"
			></circle>
			<path
				d="M12 2.4v2.3M12 19.3v2.3M2.4 12h2.3M19.3 12h2.3M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"></path>
		</svg>
	</button>
	<a class="corner" href="/" aria-label="Home">
		<span aria-hidden="true">×</span>
	</a>
</header>

<script>
	const header = document.querySelector('.site-header');
	const toggle = header?.querySelector<HTMLButtonElement>('.theme-toggle');

	function updateHeader() {
		header?.classList.toggle('is-stuck', window.scrollY > 12);
	}

	function syncTheme() {
		const dark = document.body.dataset.theme === 'dark';
		header?.classList.toggle('dark', dark);
		header?.classList.toggle('light', !dark);
		if (!toggle) return;
		toggle.setAttribute('aria-pressed', dark ? 'true' : 'false');
		toggle.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
		document
			.querySelector('meta[name="theme-color"]')
			?.setAttribute('content', getComputedStyle(document.documentElement).getPropertyValue('--header').trim());
	}

	updateHeader();
	syncTheme();
	window.addEventListener('scroll', updateHeader, { passive: true });
	if (toggle && toggle.dataset.bound !== 'true') {
		toggle.dataset.bound = 'true';
		toggle.addEventListener('click', () => {
			const next = document.body.dataset.theme === 'dark' ? 'light' : 'dark';
			document.body.dataset.theme = next;
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {
				/* keep the choice for this page if storage is blocked */
			}
			syncTheme();
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem 2rem;
		width: 100%;
		min-height: 4.4rem;
		padding: 0.95rem 5rem 0.95rem 2.2rem;
		-webkit-backdrop-filter: blur(0);
		backdrop-filter: blur(0);
		transition:
			box-shadow 0.45s ease,
			padding 0.45s ease,
			background-color 0.45s ease,
			backdrop-filter 0.45s ease;
	}

	.site-header.is-stuck {
		padding-block: 0.65rem;
		min-height: 3.6rem;
	}

	.brand,
	nav a {
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		text-decoration: none;
	}

	.brand {
		font-style: italic;
		font-size: 1.45rem;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	nav {
		display: flex;
		flex: 1 1 auto;
		flex-wrap: wrap;
		justify-content: flex-end;
		min-width: 0;
		gap: 0.35rem 1.2rem;
	}

	nav a {
		font-size: 0.92rem;
	}

	nav a[aria-current='page'],
	nav a:hover {
		text-decoration: underline;
		text-underline-offset: 0.28em;
	}

	.light,
	:global(html[data-theme='light']) .site-header {
		background-color: var(--header);
	}

	.light.is-stuck,
	:global(html[data-theme='light']) .site-header.is-stuck {
		background-color: var(--header-stuck);
		-webkit-backdrop-filter: blur(16px);
		backdrop-filter: blur(16px);
		box-shadow: 0 10px 24px var(--shadow);
	}

	.light .brand,
	.light nav a,
	:global(html[data-theme='light']) .brand,
	:global(html[data-theme='light']) nav a {
		color: var(--accent);
	}

	.dark,
	:global(html[data-theme='dark']) .site-header {
		background-color: var(--header);
	}

	.dark.is-stuck,
	:global(html[data-theme='dark']) .site-header.is-stuck {
		background-color: var(--header-stuck);
		-webkit-backdrop-filter: blur(16px);
		backdrop-filter: blur(16px);
		box-shadow: 0 12px 28px var(--shadow);
	}

	.dark .brand,
	.dark nav a,
	:global(html[data-theme='dark']) .brand,
	:global(html[data-theme='dark']) nav a {
		color: var(--accent);
	}

	.theme-toggle {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.4rem;
		height: 2.4rem;
		margin-left: 0.35rem;
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
		cursor: pointer;
	}

	.light .theme-toggle,
	.dark .theme-toggle,
	:global(html[data-theme='light']) .theme-toggle,
	:global(html[data-theme='dark']) .theme-toggle {
		color: var(--accent);
	}

	.theme-toggle svg {
		width: 1.35rem;
		height: 1.35rem;
	}

	.icon-sun {
		display: none;
	}

	.dark .icon-sun,
	:global(html[data-theme='dark']) .icon-sun {
		display: block;
	}

	.dark .icon-moon,
	:global(html[data-theme='dark']) .icon-moon {
		display: none;
	}

	:global(html[data-theme='light']) .icon-sun {
		display: none;
	}

	:global(html[data-theme='light']) .icon-moon {
		display: block;
	}

	.corner {
		position: absolute;
		top: 0;
		right: 0;
		z-index: 2;
		width: 4.6rem;
		height: 4.6rem;
		color: #161616;
		text-decoration: none;
		font-size: 1.45rem;
		line-height: 1;
	}

	.corner::before {
		content: "";
		position: absolute;
		inset: 0;
		background: #fff;
		clip-path: polygon(0 0, 100% 0, 100% 100%);
	}

	.corner span {
		position: absolute;
		top: 0.22rem;
		right: 0.5rem;
		z-index: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header {
			transition: none;
		}
	}

	@media (max-width: 860px) {
		.site-header {
			align-items: flex-start;
			flex-direction: column;
			padding: 0.9rem 4.2rem 0.85rem 1.1rem;
			gap: 0.55rem;
		}

		nav {
			justify-content: flex-start;
		}

		.theme-toggle {
			position: absolute;
			top: 0.72rem;
			right: 4.85rem;
			z-index: 3;
			margin-left: 0;
		}
	}
</style>
