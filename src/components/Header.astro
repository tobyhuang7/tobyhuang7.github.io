---
import { nav } from '../data/portfolio';

interface Props {
	theme: 'light' | 'dark';
	current?: string;
}

const { theme, current } = Astro.props;
---

<header class:list={['site-header', theme]}>
	<a class="brand" href="/">Toby’s Portfolio</a>
	<nav aria-label="Portfolio sections">
		{
			nav.map((item) => (
				<a
					href={`/${item.slug}`}
					aria-current={current === item.slug ? 'page' : undefined}
				>
					{item.label}
				</a>
			))
		}
	</nav>
	<a class="corner" href="/" aria-label="Home">
		<span aria-hidden="true">×</span>
	</a>
</header>

<script>
	const header = document.querySelector('.site-header');

	function updateHeader() {
		header?.classList.toggle('is-stuck', window.scrollY > 12);
	}

	updateHeader();
	window.addEventListener('scroll', updateHeader, { passive: true });
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem 2rem;
		width: 100%;
		min-height: 4.4rem;
		padding: 0.95rem 5rem 0.95rem 2.2rem;
		-webkit-backdrop-filter: blur(0);
		backdrop-filter: blur(0);
		transition:
			box-shadow 0.45s ease,
			padding 0.45s ease,
			background-color 0.45s ease,
			backdrop-filter 0.45s ease;
	}

	.site-header.is-stuck {
		padding-block: 0.65rem;
		min-height: 3.6rem;
	}

	.brand,
	nav a {
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		text-decoration: none;
	}

	.brand {
		font-style: italic;
		font-size: 1.45rem;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	nav {
		display: flex;
		flex: 1 1 auto;
		flex-wrap: wrap;
		justify-content: flex-end;
		min-width: 0;
		gap: 0.35rem 1.2rem;
	}

	nav a {
		font-size: 0.92rem;
	}

	nav a[aria-current='page'],
	nav a:hover {
		text-decoration: underline;
		text-underline-offset: 0.28em;
	}

	.light {
		background-color: #e4e9fd;
	}

	.light.is-stuck {
		background-color: rgba(228, 233, 253, 0.72);
		-webkit-backdrop-filter: blur(16px);
		backdrop-filter: blur(16px);
		box-shadow: 0 10px 24px rgba(55, 68, 120, 0.28);
	}

	.light .brand,
	.light nav a {
		color: #6a7ab4;
	}

	.dark {
		background-color: #181d3b;
	}

	.dark.is-stuck {
		background-color: rgba(24, 29, 59, 0.72);
		-webkit-backdrop-filter: blur(16px);
		backdrop-filter: blur(16px);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
	}

	.dark .brand,
	.dark nav a {
		color: #ee9cf9;
	}

	.corner {
		position: absolute;
		top: 0;
		right: 0;
		z-index: 2;
		width: 4.6rem;
		height: 4.6rem;
		color: #161616;
		text-decoration: none;
		font-size: 1.45rem;
		line-height: 1;
	}

	.corner::before {
		content: "";
		position: absolute;
		inset: 0;
		background: #fff;
		clip-path: polygon(0 0, 100% 0, 100% 100%);
	}

	.corner span {
		position: absolute;
		top: 0.22rem;
		right: 0.5rem;
		z-index: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header {
			transition: none;
		}
	}

	@media (max-width: 860px) {
		.site-header {
			align-items: flex-start;
			flex-direction: column;
			padding: 0.9rem 4.2rem 0.85rem 1.1rem;
			gap: 0.55rem;
		}

		nav {
			justify-content: flex-start;
		}
	}
</style>
