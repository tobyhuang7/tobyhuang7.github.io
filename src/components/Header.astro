---
import { nav } from '../data/portfolio';

interface Props {
	theme: 'light' | 'dark';
	current?: string;
}

const { theme, current } = Astro.props;
---

<header class:list={['site-header', theme]}>
	<a class="brand" href="/">Toby Huang</a>
	<button
		class="menu-toggle"
		type="button"
		aria-expanded="false"
		aria-controls="section-nav"
		aria-label="Open menu"
	>
		<svg class="icon-menu" viewBox="0 0 24 24" aria-hidden="true">
			<path
				d="M4 7h16M4 12h16M4 17h16"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"></path>
		</svg>
		<svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true">
			<path
				d="M6 6l12 12M18 6 6 18"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"></path>
		</svg>
	</button>
	<nav id="section-nav" aria-label="Portfolio sections">
		{
			nav.map((item) => (
				<a
					href={`/${item.slug}`}
					aria-current={current === item.slug ? 'page' : undefined}
				>
					{item.label}
				</a>
			))
		}
	</nav>
	<button
		class="theme-toggle"
		type="button"
		aria-pressed={theme === 'dark' ? 'true' : 'false'}
		aria-label={theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'}
	>
		<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
			<path
				d="M21 14.5A8.5 8.5 0 1 1 9.5 3a7 7 0 0 0 11.5 11.5z"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linejoin="round"></path>
		</svg>
		<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="12" cy="12" r="3.4" fill="none" stroke="currentColor" stroke-width="1.6"
			></circle>
			<path
				d="M12 2.4v2.3M12 19.3v2.3M2.4 12h2.3M19.3 12h2.3M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6"
				fill="none"
				stroke="currentColor"
				stroke-width="1.6"
				stroke-linecap="round"></path>
		</svg>
	</button>
	<a class="corner" href="/" aria-label="Home">
		<span aria-hidden="true">×</span>
	</a>
</header>

<script>
	const header = document.querySelector('.site-header');
	const toggle = header?.querySelector<HTMLButtonElement>('.theme-toggle');
	const menuButton = header?.querySelector<HTMLButtonElement>('.menu-toggle');
	const menu = header?.querySelector('nav');

	function setMenu(open: boolean) {
		header?.classList.toggle('is-open', open);
		menuButton?.setAttribute('aria-expanded', open ? 'true' : 'false');
		menuButton?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
	}

	function updateHeader() {
		header?.classList.toggle('is-stuck', window.scrollY > 12);
	}

	function syncTheme() {
		const dark = document.body.dataset.theme === 'dark';
		header?.classList.toggle('dark', dark);
		header?.classList.toggle('light', !dark);
		if (!toggle) return;
		toggle.setAttribute('aria-pressed', dark ? 'true' : 'false');
		toggle.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
		document
			.querySelector('meta[name="theme-color"]')
			?.setAttribute('content', getComputedStyle(document.documentElement).getPropertyValue('--header').trim());
	}

	updateHeader();
	syncTheme();
	window.addEventListener('scroll', updateHeader, { passive: true });
	if (menuButton && menuButton.dataset.bound !== 'true') {
		menuButton.dataset.bound = 'true';
		menuButton.addEventListener('click', (event) => {
			event.stopPropagation();
			setMenu(!header?.classList.contains('is-open'));
		});
		menu?.addEventListener('click', (event) => {
			if ((event.target as Element).closest('a')) window.setTimeout(() => setMenu(false), 0);
		});
		document.addEventListener('click', (event) => {
			if (!header?.contains(event.target as Node)) setMenu(false);
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setMenu(false);
		});
	}
	if (toggle && toggle.dataset.bound !== 'true') {
		toggle.dataset.bound = 'true';
		toggle.addEventListener('click', () => {
			const next = document.body.dataset.theme === 'dark' ? 'light' : 'dark';
			document.body.dataset.theme = next;
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {
				/* keep the choice for this page if storage is blocked */
			}
			syncTheme();
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem 2rem;
		width: 100%;
		min-height: 4.4rem;
		padding: 0.95rem 5rem 0.95rem 2.2rem;
		-webkit-backdrop-filter: blur(0);
		backdrop-filter: blur(0);
		transition:
			box-shadow 0.45s ease,
			padding 0.45s ease,
			background-color 0.45s ease,
			backdrop-filter 0.45s ease;
	}

	.site-header.is-stuck {
		padding-block: 0.65rem;
		min-height: 3.6rem;
	}

	.brand,
	nav a {
		font-family: "Libre Baskerville", Palatino, Georgia, serif;
		text-decoration: none;
	}

	.brand {
		font-style: italic;
		font-size: 1.45rem;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	nav {
		display: flex;
		flex: 1 1 auto;
		flex-wrap: wrap;
		justify-content: flex-end;
		min-width: 0;
		gap: 0.35rem 1.2rem;
	}

	nav a {
		font-size: 0.92rem;
	}

	nav a[aria-current='page'],
	nav a:hover {
		text-decoration: underline;
		text-underline-offset: 0.28em;
	}

	.light,
	:global(html[data-theme='light']) .site-header {
		background-color: var(--header);
	}

	.light.is-stuck,
	:global(html[data-theme='light']) .site-header.is-stuck {
		background-color: var(--header-stuck);
		-webkit-backdrop-filter: blur(16px);
		backdrop-filter: blur(16px);
		box-shadow: 0 10px 24px var(--shadow);
	}

	.light .brand,
	.light nav a,
	:global(html[data-theme='light']) .brand,
	:global(html[data-theme='light']) nav a {
		color: var(--accent);
	}

	.dark,
	:global(html[data-theme='dark']) .site-header {
		background-color: var(--header);
	}

	.dark.is-stuck,
	:global(html[data-theme='dark']) .site-header.is-stuck {
		background-color: var(--header-stuck);
		-webkit-backdrop-filter: blur(16px);
		backdrop-filter: blur(16px);
		box-shadow: 0 12px 28px var(--shadow);
	}

	.dark .brand,
	.dark nav a,
	:global(html[data-theme='dark']) .brand,
	:global(html[data-theme='dark']) nav a {
		color: var(--accent);
	}

	.menu-toggle,
	.theme-toggle {
		display: grid;
		place-items: center;
		flex: none;
		width: 2.4rem;
		height: 2.4rem;
		margin-left: 0.35rem;
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
		cursor: pointer;
	}

	.menu-toggle {
		display: none;
	}

	.light .menu-toggle,
	.dark .menu-toggle,
	.light .theme-toggle,
	.dark .theme-toggle,
	:global(html[data-theme='light']) .menu-toggle,
	:global(html[data-theme='dark']) .menu-toggle,
	:global(html[data-theme='light']) .theme-toggle,
	:global(html[data-theme='dark']) .theme-toggle {
		color: var(--accent);
	}

	.menu-toggle svg,
	.theme-toggle svg {
		width: 1.35rem;
		height: 1.35rem;
	}

	.icon-close {
		display: none;
	}

	.site-header.is-open .icon-menu {
		display: none;
	}

	.site-header.is-open .icon-close {
		display: block;
	}

	.icon-sun {
		display: none;
	}

	.dark .icon-sun,
	:global(html[data-theme='dark']) .icon-sun {
		display: block;
	}

	.dark .icon-moon,
	:global(html[data-theme='dark']) .icon-moon {
		display: none;
	}

	:global(html[data-theme='light']) .icon-sun {
		display: none;
	}

	:global(html[data-theme='light']) .icon-moon {
		display: block;
	}

	.corner {
		position: absolute;
		top: 0;
		right: 0;
		z-index: 2;
		width: 4.6rem;
		height: 4.6rem;
		color: #161616;
		text-decoration: none;
		font-size: 1.45rem;
		line-height: 1;
	}

	.corner::before {
		content: "";
		position: absolute;
		inset: 0;
		background: #fff;
		clip-path: polygon(0 0, 100% 0, 100% 100%);
	}

	.corner span {
		position: absolute;
		top: 0.22rem;
		right: 0.5rem;
		z-index: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header {
			transition: none;
		}
	}

	@media (max-width: 860px) {
		.site-header {
			align-items: center;
			padding: 0.7rem 4.7rem 0.7rem 1.1rem;
			gap: 0.2rem;
			min-height: 4.4rem;
		}

		.brand {
			flex: 1 1 auto;
			order: 1;
		}

		.menu-toggle {
			display: grid;
			order: 2;
			margin-left: 0;
		}

		.theme-toggle {
			order: 3;
			margin-left: 0;
		}

		nav {
			position: absolute;
			top: calc(100% + 0.45rem);
			right: 4.7rem;
			left: auto;
			z-index: 4;
			display: flex;
			flex: none;
			flex-direction: column;
			align-items: flex-start;
			justify-content: flex-start;
			width: max-content;
			max-width: calc(100% - 5.8rem);
			gap: 0.85rem;
			padding: 0.95rem 1.15rem 1.05rem;
			background: var(--header);
			border-radius: 1rem;
			box-shadow:
				0 2px 6px var(--shadow),
				0 14px 32px var(--shadow);
			transform-origin: top right;
			transform: translateY(-0.45rem);
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			clip-path: inset(0 0 100% 0 round 1rem);
			transition:
				transform 0.38s cubic-bezier(0.2, 0.75, 0.2, 1),
				opacity 0.28s ease,
				clip-path 0.38s cubic-bezier(0.2, 0.75, 0.2, 1),
				visibility 0s linear 0.38s;
		}

		.site-header.is-open nav {
			transform: none;
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			clip-path: inset(0 0 0 0 round 1rem);
			transition-delay: 0s;
		}
	}

	@media (max-width: 860px) and (prefers-reduced-motion: reduce) {
		nav {
			transform: none;
			transition: none;
		}
	}
</style>
